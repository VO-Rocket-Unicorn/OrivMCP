# OrivMCP configuration — copy to `.env` and fill in.
#
#   cp .env.example .env
#
# Variable names are flat; the code addresses them in groups
# (settings.server.port, settings.urls.odas_base_url) without renaming any of
# them. Unknown variables are ignored, so anything extra here is harmless.
#
# LIST VALUES MUST BE JSON ARRAYS. `ALLOWED_HOSTS=a,b` is not parsed as a list —
# it raises a SettingsError before the server starts. Use ["a","b"].
#
# Legend:  [required]  the process will not start, or a tool cannot answer,
#                      without it
#          [optional]  has a working default; the commented line shows either
#                      that default or, where the default is empty, a usable
#                      example — the comment above each says which


# ============================================================================
# Required
# ============================================================================

# [required] Where OpenTelemetry logs, traces and metrics are exported.
# The only variable with no default at all: the process fails to start without
# it. Point it at your collector's base URL — the /v1/* paths are appended.
OTEL_URL=http://localhost:4318

# [required] Host header values this server will serve, as a JSON array.
# Defaults to [] — and DNS-rebinding protection is on, so an empty list means
# every request is rejected. Include every name a client reaches this server
# by: localhost for local work, plus any tunnel or deployed hostname. A bare
# entry also matches any port; scheme and path are stripped for you.
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# [required, for the tools to return data] Base URL of ODAS, which serves both
# the device-class taxonomy and the requirement tree. Left empty, the server
# still starts and every ODAS-backed tool answers with "not configured".
# Its reachability is probed once at startup and logged, never fatal.
ODAS_BASE_URL=https://dev-api.oriv.studio

# NOTE — nothing caller-specific belongs here. Two values arrive per request
# instead, on headers: `X-ODAS-Token`, the caller's own ODAS credential (this
# server holds none of its own), and `X-Project-Id`, the project the
# requirement tools read — fixed for a session, so it is not a tool argument.


# ============================================================================
# Optional — environment and logging
# ============================================================================

# [optional] One of: sandbox | development | staging | production.
# `sandbox` switches logging to DEBUG and to the console; every other value
# logs at INFO through the telemetry handler.
#ENVIRONMENT=production

# [optional] Directory application logs are written to.
# Defaults to the `logs/` directory at the repo root, resolved at startup.
#LOG_FILE_PATH=/var/log/oriv-mcp


# ============================================================================
# Optional — how the server binds and serves
# ============================================================================

# [optional] Name this server reports to MCP clients.
#PROJECT_NAME=OrivMCP

# [optional] Interface and port uvicorn binds.
#HOST=0.0.0.0
#PORT=8000

# [optional] Uvicorn worker processes, and how long a Keep-Alive connection
# waits for the next request, in seconds.
#WORKERS=1
#TIMEOUT_KEEP_ALIVE=5

# [optional] Path the streamable HTTP MCP endpoint is served from. It is also
# aliased at `/`, so a client given the bare base URL still connects.
#MCP_PATH=/mcp

# [optional] Allowed Origin header values, as a JSON array. Defaults to [],
# which is fine for non-browser MCP clients — they send no Origin at all. Set
# it only for a browser-based client. Entries keep their scheme, and a bare
# entry matches any port.
#ALLOWED_ORIGINS=["http://localhost","http://127.0.0.1"]


# ============================================================================
# Optional — outbound HTTP
# ============================================================================

# [optional] Per-request timeout for calls this server makes, in seconds.
#HTTP_TIMEOUT_SECONDS=10.0

# [optional] Connection-pool ceiling for the shared HTTP client.
#HTTP_MAX_CONNECTIONS=20


# ============================================================================
# Optional — endpoint paths
# ============================================================================
# Only set these if a service moves an endpoint. The defaults are the contract
# as it stands, and each is appended to the base URL above it.

# Device-class taxonomy, under ODAS_BASE_URL.
#DEVICE_CLASSES_PATH=/api/v1/device-classes
#SEARCH_PATH=/search

# Requirement tree, under ODAS_BASE_URL. Requirements hang beneath one project:
# <PROJECTS_PATH>/{projectId}<REQUIREMENTS_PATH>/{requirementId}<ANCESTORS_PATH>
#PROJECTS_PATH=/api/v1/projects
#REQUIREMENTS_PATH=/requirements
#ANCESTORS_PATH=/ancestors

# Startup reachability probe. Sits at the ODAS host root, not under a collection.
#ODAS_HEALTH_PATH=/health

# Telemetry export paths, under OTEL_URL.
#OTEL_LOGS_PATH=/v1/logs
#OTEL_TRACES_PATH=/v1/traces
#OTEL_METRICS_PATH=/v1/metrics
